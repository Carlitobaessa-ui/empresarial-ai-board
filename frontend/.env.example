# Mesmos valores configurados no backend/.env (GOOGLE_CLIENT_ID / APPLE_CLIENT_ID).
# Vazio = o botao correspondente simplesmente nao aparece na tela de login.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# URL publica do backend quando ele roda em outro dominio (ex.: Render).
# Vazio = usa caminho relativo /api (funciona em dev local com o proxy do Vite).
# Em producao (GitHub Pages), defina o secret VITE_API_URL no GitHub Actions
# com a URL do backend, ex.: https://empresarial-ai-board-api.onrender.com
VITE_API_URL=
