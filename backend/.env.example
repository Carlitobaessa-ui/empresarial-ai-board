# Porta do servidor backend
PORT=4000

# Chave da API da Anthropic (obtida em https://console.anthropic.com)
# Sem essa chave, os agentes nao conseguem gerar respostas de IA reais.
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# Modelo usado pelos agentes. Confira o identificador mais recente em
# https://docs.claude.com/en/docs/about-claude/models antes de colocar em producao.
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Senha simples para liberar as acoes de edicao no Painel Admin
# (criar/editar/excluir agentes). Troque por uma senha sua.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar os tokens de login dos usuarios do app de chat.
# Troque por um valor aleatorio e longo (ex.: gere com `openssl rand -hex 32`).
JWT_SECRET=troque-por-um-valor-aleatorio-e-secreto

# URL onde o FRONTEND roda (usada nos redirecionamentos do Stripe Checkout/Portal)
APP_URL=http://localhost:5173

# --- Stripe (assinaturas pagas por agente ou por pacote) ---
# Chave secreta de TESTE da sua conta Stripe (comeca com sk_test_...)
# Sem ela, o botao "Assinar" nao funciona, mas o resto do app continua ok.
STRIPE_SECRET_KEY=

# Segredo do endpoint de webhook (comeca com whsec_...). Em desenvolvimento local,
# gere um rodando: stripe listen --forward-to localhost:4000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# --- Login social (opcional) ---
# Client ID OAuth do Google (console.cloud.google.com > Credenciais > OAuth client ID
# do tipo "Web application"). O MESMO valor tambem vai no frontend/.env como
# VITE_GOOGLE_CLIENT_ID. Funciona em localhost durante o desenvolvimento.
GOOGLE_CLIENT_ID=

# Identifier do "Services ID" criado no Apple Developer (developer.apple.com >
# Certificates, Identifiers & Profiles > Identifiers > Services IDs). O MESMO
# valor tambem vai no frontend/.env como VITE_APPLE_CLIENT_ID.
# IMPORTANTE: a Apple exige um dominio HTTPS real e verificado nos "Return URLs"
# do Services ID - o botao "Continuar com Apple" NAO funciona em localhost.
# So sera testavel de fato depois que o app estiver publicado em um dominio HTTPS.
APPLE_CLIENT_ID=
